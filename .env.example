# ──────────────────────────────────────────────────────────────
#  Cricbuzz Live Analytics - environment variables
#  Copy this file to `.env` and fill in your own credentials.
#  Never commit the real `.env` file to git.
# ──────────────────────────────────────────────────────────────

# RapidAPI key for the Cricbuzz Cricket API
# https://rapidapi.com/cricketapilive/api/cricbuzz-cricket
RAPIDAPI_KEY=your_rapidapi_key_here

# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=cricket_db

# Optional - override location of the 25 .sql question files
# SQL_QUESTIONS_DIR=./sql_questions
